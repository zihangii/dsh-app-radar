{
  "name": "dsh-app-radar",
  "version": "1.0.2",
  "description": "应用雷达：把 DSH 在后台启动的进程和端口列成一张控制台，一键强制停止。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "README.md",
    "CREDITS.md",
    "LICENSE",
    "screenshots.json",
    "assets/screenshots/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "process-manager",
    "ports",
    "dev-server",
    "kill-process"
  ],
  "license": "MIT",
  "author": "zihangii",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zihangii/dsh-app-radar.git"
  },
  "homepage": "https://github.com/zihangii/dsh-app-radar",
  "bugs": {
    "url": "https://github.com/zihangii/dsh-app-radar/issues"
  }
}
